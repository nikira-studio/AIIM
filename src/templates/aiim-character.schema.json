{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiim.local/schemas/aiim-character-v1.json",
  "title": "AIIM character",
  "description": "A portable AI Instant Messenger buddy personality. Provider settings, credentials, chats, and memories are excluded.",
  "type": "object",
  "required": ["schemaVersion", "displayName", "screenName", "systemPrompt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "screenName": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "tagline": { "type": "string" },
    "pack": { "type": "string" },
    "group": { "type": "string" },
    "userRole": { "type": "string" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "statusMessage": { "type": "string" },
    "awayMessage": { "type": "string" },
    "typingStyle": { "enum": ["quick", "measured", "thoughtful"] },
    "profileBio": { "type": "string" },
    "profileLocation": { "type": "string" },
    "profileInterests": { "type": "string" },
    "profileQuote": { "type": "string" },
    "presencePattern": { "enum": ["always", "daytime", "evening", "varied"] },
    "notificationSound": { "enum": ["classic", "soft", "digital", "none"] },
    "fontFamily": { "enum": ["Tahoma", "Verdana", "Arial", "Georgia", "Courier New"] },
    "fontColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "relationshipNotes": { "type": "string" },
    "systemPrompt": { "type": "string", "minLength": 1 },
    "avatarFile": { "type": "string" },
    "avatarDataUrl": { "type": "string", "pattern": "^data:image/(png|jpeg|webp|gif);base64," }
  },
  "additionalProperties": false
}
