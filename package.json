{
  "name": "ai-messenger",
  "version": "1.1.0",
  "private": true,
  "description": "A local-first, late-90s-style desktop messenger for talking with AI friends.",
  "author": {
    "name": "Nikira Studio",
    "url": "https://nikira.com"
  },
  "homepage": "https://nikira.com",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "clean": "node scripts/clean.mjs",
    "clean:releases": "node scripts/clean-releases.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run src",
    "test:ui:built": "node scripts/run-ui-smoke.cjs",
    "verify": "node scripts/verify-release.mjs",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "start": "electron .",
    "package:win": "npm run build && npm run clean:releases && electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.aimessenger.desktop",
    "productName": "AI Instant Messenger",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "releases"
    },
    "win": {
      "target": "nsis",
      "icon": "build/running-robot.png"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
